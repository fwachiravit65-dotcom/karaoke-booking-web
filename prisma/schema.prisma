// Prisma Schema for MOOD Karaoke Booking Web
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoomType {
  STANDARD_S // 2-4 persons
  STANDARD_M // 5-8 persons
  PARTY_L    // 9-14 persons
  VIP_LUXURY // 15-22 persons
}

enum BookingStatus {
  PENDING   // Awaiting admin/slip verification
  CONFIRMED // Verified & Room Reserved
  CANCELLED // Cancelled by customer or admin
  REJECTED  // Invalid slip or payment failed
  COMPLETED // Finished session
}

model Member {
  id                    String    @id @default(uuid())
  phone                 String    @unique // 10-digit phone number as login ID
  name                  String
  pinHash               String    // 6-digit PIN hash
  totalHoursAccumulated Int       @default(0)
  freeHoursAvailable    Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  bookings              Booking[]

  @@map("members")
}

model Room {
  id           String        @id @default(uuid())
  roomNumber   String        @unique
  name         String
  type         RoomType      @default(STANDARD_S)
  capacityMin  Int           @default(2)
  capacityMax  Int           @default(6)
  pricePerHour Decimal       @db.Decimal(10, 2)
  description  String?
  features     String[]      @default([])
  imageUrl     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]

  @@map("rooms")
}

model PackageAddon {
  id          String           @id @default(uuid())
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  isAvailable Boolean          @default(true)
  createdAt   DateTime         @default(now())
  bookings    BookingPackage[]

  @@map("package_addons")
}

model Booking {
  id             String           @id @default(uuid())
  bookingCode    String           @unique
  roomId         String
  room           Room             @relation(fields: [roomId], references: [id])
  memberId       String?
  member         Member?          @relation(fields: [memberId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  bookingDate    DateTime         @db.Date
  startTime      String
  endTime        String
  totalHours     Int
  roomCharge     Decimal          @db.Decimal(10, 2)
  packageCharge  Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal          @db.Decimal(10, 2)
  depositAmount  Decimal          @db.Decimal(10, 2)
  status         BookingStatus    @default(PENDING)
  slipImageUrl   String?
  adminNotes     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  packages       BookingPackage[]

  @@index([roomId, bookingDate, status])
  @@index([customerPhone])
  @@map("bookings")
}

model BookingPackage {
  id         String       @id @default(uuid())
  bookingId  String
  packageId  String
  quantity   Int          @default(1)
  price      Decimal      @db.Decimal(10, 2)
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package    PackageAddon @relation(fields: [packageId], references: [id])

  @@map("booking_packages")
}
