# -------------------------------------------------------------
# Karaoke Booking Web - Environment Variables Template
# -------------------------------------------------------------
# Copy this file to .env.local for local development

# NEXT PUBLIC URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SUPABASE SETTINGS (Get these from your Supabase Dashboard: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PRISMA DATABASE CONNECTION (Direct or Pooled Connection from Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ADMIN ACCESS
ADMIN_SECRET_KEY="super-secret-admin-passcode"
